{
  "schema_version": 1,
  "evaluation_status": "cases_authored_not_image_regression_passed",
  "cases": [
    {
      "id": "S01",
      "type": "normal",
      "prompt": "画出应用 A、应用 B 与资料库、成果库的关系。两个应用均可读写两类资源，但彼此不直接通信。",
      "route": "visual-explain/structure",
      "must": [
        "四个对象",
        "四组明确读写访问关系",
        "两类资源均保留"
      ],
      "must_not": [
        "应用之间的直连",
        "无依据的资源间同步"
      ]
    },
    {
      "id": "S02",
      "type": "revision",
      "prompt": "在 S01 的成图上减少视觉噪声、改善排版，原有关系不变。",
      "route": "visual-explain/structure",
      "must": [
        "保留S01全部语义约束",
        "优先删装饰与重复说明"
      ],
      "must_not": [
        "省略任一必要资源",
        "为减少交叉而新增应用间连接"
      ]
    },
    {
      "id": "S03",
      "type": "ambiguous",
      "prompt": "这些概念是不是都该并列？已有说明同时包含协议、内容、封装和运行时。先核查关系再画。",
      "route": "visual-explain/structure",
      "must": [
        "把提问当待验证假设",
        "区分不同关系与抽象层"
      ],
      "must_not": [
        "未经验证改成全并列",
        "把它们一概串成流程"
      ]
    },
    {
      "id": "S04",
      "type": "tempting-failure",
      "prompt": "将已有系统放在较窄的背景区域，主要画幅解释能力封装。面积分配只是构图约束，不是正文。",
      "route": "visual-explain/structure",
      "must": [
        "保留已有系统与能力封装的关系",
        "区分构图指令和画面文案"
      ],
      "must_not": [
        "将面积分配或布局说明印进图里"
      ]
    },
    {
      "id": "P01",
      "type": "normal",
      "prompt": "画一个交付过程：需求澄清、设计、实现、验收。设计与验收由人工批准，实现由工具执行，并显示退回修改的条件。",
      "route": "visual-explain/process",
      "must": [
        "职责与动作区分",
        "明确批准点与条件",
        "业务完成边界"
      ],
      "must_not": [
        "把所有角色都画成Agent",
        "把一次调用结束当业务完成"
      ]
    },
    {
      "id": "P02",
      "type": "composite",
      "prompt": "以同一个交付项目为例，展示采用新方法前后的流程变化，并把区别放在图上。",
      "route": "visual-explain/process+comparison-evolution",
      "must": [
        "同一项目和步骤粒度",
        "变化与具体步骤对齐"
      ],
      "must_not": [
        "两套无法对应的术语",
        "脱离流程的泛泛优缺点清单"
      ]
    },
    {
      "id": "C01",
      "type": "normal",
      "prompt": "根据给定材料画一张技术谱系。材料明确存在分叉、依赖和长期共存，时间信息只作辅助。",
      "route": "visual-explain/comparison-evolution",
      "must": [
        "依赖与分叉",
        "并存关系",
        "日期只作有依据的辅助"
      ],
      "must_not": [
        "强行单线替代",
        "把时间先后直接当依赖"
      ]
    },
    {
      "id": "C02",
      "type": "edge",
      "prompt": "做一张团队能力升级路线图，给出何时可进入下一阶段；当前阶段未提供。",
      "route": "visual-explain/comparison-evolution",
      "must": [
        "可观察的晋级条件",
        "具体场景或交付物"
      ],
      "must_not": [
        "替团队编造当前位置",
        "只有越往右越先进的标签"
      ]
    },
    {
      "id": "T01",
      "type": "normal",
      "prompt": "给成人培训师画一张教学设计方法图，再用同样结构给初学者解释一个具体概念。",
      "route": "visual-explain/teaching",
      "must": [
        "区分图的读者和教学对象",
        "稳定方法结构，调整例子"
      ],
      "must_not": [
        "方法图自动儿童化",
        "仅保留名词而没有机制"
      ]
    },
    {
      "id": "T02",
      "type": "ambiguous",
      "prompt": "图解一个方向题，题目未给出观察方向；不同方向会改变位置判断，现有条件不足以排除任一种解释。",
      "route": "visual-explain/teaching",
      "must": [
        "标明歧义或提出必要澄清",
        "不同解释各自有条件"
      ],
      "must_not": [
        "暗中选择一个解释并给唯一答案"
      ]
    },
    {
      "id": "T03",
      "type": "edge",
      "prompt": "画出六个标记物的空间关系，并分别展示俯视位置图与指定观察点实际看到的画面。",
      "route": "visual-explain/teaching+evidence",
      "must": [
        "准确六个标记物",
        "区分位置图与观察视角",
        "核验实际成图数量"
      ],
      "must_not": [
        "物件数量随插画变化",
        "用俯视图冒充观察者所见"
      ]
    },
    {
      "id": "E01",
      "type": "tempting-failure",
      "prompt": "没有实测数据，画一张解释响应延迟与识别准确率权衡的帕累托示意图，不能冒充产品排名。",
      "route": "visual-explain/evidence",
      "must": [
        "明确示意而非实测",
        "坐标方向和概念意义"
      ],
      "must_not": [
        "具体产品的伪精确坐标",
        "无证据SOTA标记"
      ]
    },
    {
      "id": "E02",
      "type": "edge",
      "prompt": "展示按顺序分箱的数量与累计数量：每箱分别3、2、4。另有累计转化率，不要求其单调。",
      "route": "visual-explain/evidence",
      "must": [
        "累计数量3、5、9",
        "确定性计算并核对标签",
        "区分计数与比率"
      ],
      "must_not": [
        "强迫累计比率单调",
        "生成式虚构柱高或数值"
      ]
    },
    {
      "id": "E03",
      "type": "freshness",
      "prompt": "把模型对比图里的旧版本换成当前大量使用的版本，并保留数据口径。",
      "route": "visual-explain/evidence",
      "must": [
        "核实当前版本与来源日期",
        "数据与版本相符",
        "无法获得新数据则保留限制"
      ],
      "must_not": [
        "只换模型名沿用旧数据",
        "凭记忆宣称最新"
      ]
    },
    {
      "id": "N01",
      "type": "normal",
      "prompt": "为文章中的一个局部机制配图：多个渠道的请求共用一个校验流程。只解释这一机制，不概括其他章节。",
      "route": "visual-story",
      "must": [
        "局部论证的独有问题",
        "围绕共用校验流程组织主视觉"
      ],
      "must_not": [
        "重新概括整篇文章",
        "平均排布全部章节"
      ]
    },
    {
      "id": "N02",
      "type": "scope",
      "prompt": "把一项操作方法做成三页连续图，现在只生成第一页。使用清晰的视觉层级，不要把长段说明塞进卡片。",
      "route": "visual-story",
      "must": [
        "先有三页的简短分镜",
        "每页独有贡献",
        "只生成第一页",
        "把详细解释移到合适载体"
      ],
      "must_not": [
        "一次生成三张",
        "三页重复同一总结",
        "只有少字口号但无法理解"
      ]
    },
    {
      "id": "N03",
      "type": "revision",
      "prompt": "上一版太空了。这一页需要脱离正文也能读懂，可以适当多一点文字，但不要新增论点。",
      "route": "visual-story",
      "must": [
        "恢复独立理解必要的解释",
        "保留既定主张"
      ],
      "must_not": [
        "机械执行越少字越好",
        "添加无证据的新主张"
      ]
    },
    {
      "id": "A01",
      "type": "normal",
      "prompt": "基于当前可用参考图，提出三种实质不同的插画方向，保持主体身份和对象类别。",
      "route": "visual-art-direction",
      "must": [
        "三个实质不同方向",
        "保持主体",
        "遵守参考约束"
      ],
      "must_not": [
        "仅换三种颜色",
        "擅自改变主体身份或对象类别"
      ]
    },
    {
      "id": "A02",
      "type": "missing-input",
      "prompt": "更改此前选定封面的配色。当前未提供参考图片，旧图也无法访问。",
      "route": "visual-art-direction",
      "must": [
        "请求实际可用目标或定位可访问图片"
      ],
      "must_not": [
        "调用编辑工具处理虚构目标",
        "凭描述猜造应被保留的原图"
      ]
    },
    {
      "id": "A03",
      "type": "revision",
      "prompt": "基于当前可见图片，将参考 A 的前景与参考 B 的背景合成；再做一张横幅，横幅不保留前景主体。",
      "route": "visual-art-direction",
      "must": [
        "参考标识可对应",
        "按部分分配参考",
        "横幅去掉前景主体"
      ],
      "must_not": [
        "将所有参考混成一种风格",
        "横幅继续保留明确排除的主体"
      ]
    },
    {
      "id": "D01",
      "type": "delivery",
      "prompt": "直接给成图，不要 Mermaid，也不要只有提示词；没有要求制作幻灯片。",
      "route": "visual-explain",
      "must": [
        "实际可用图片交付",
        "遵守宿主工具规则"
      ],
      "must_not": [
        "Mermaid代码充数",
        "仅返回生图提示词",
        "自动新增PPT或发布动作"
      ]
    }
  ]
}
